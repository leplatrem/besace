#!/bin/sh
eventPayload=$(cat /dev/stdin | jq .)
folder_id=$(echo $eventPayload | jq -r .Event.Upload.MetaData.folderId)
source=$(echo $eventPayload | jq -r .Event.Upload.Storage.Path)
filename=$(echo $eventPayload | jq -r .Event.Upload.MetaData.filename)

echo "Receiving ${source}" >&2

# Same pattern as the API (eg. `ossa-teneas-doctum`). Rejects empty, `.`, `..`, etc.
if ! printf '%s' "${folder_id}" | grep -Eqx '[a-zA-Z]+-[a-zA-Z]+-[a-zA-Z]+'; then
    echo "Invalid folder" >&2
    echo '{"detail": "Invalid folder"}'
    exit 1
fi

# No path separator, no leading dot, no quote/brackets or control characters.
if [ -z "${filename}" ] || printf '%s' "${filename}" | grep -Eq '^\.|[/\\<>"]|[[:cntrl:]]'; then
    echo "Invalid filename" >&2
    echo '{"detail": "Invalid filename"}'
    exit 1
fi

echo "Checking folder ${BESACE_ROOT_FOLDER}/${folder_id}/" >&2
if [ ! -d "${BESACE_ROOT_FOLDER}/${folder_id}" ]; then
    echo "Unknown folder ${folder_id}" >&2
    echo "Deleting ${source}" >&2
    rm -f "${source}*"
    echo "{\"detail\": \"Unknown folder ${folder_id}\"}"
    exit 1
fi
